{
  "name": "extension-clock",
  "displayName": "Zen Clock: Pomodoro & Muslim Prayer Times",
  "description": "A mindful 3D flip clock, background Pomodoro timer, and automated Muslim prayer times with adhan reminder for VS Code & Antigravity IDE",
  "version": "0.0.1",
  "publisher": "lutfialdrii",
  "icon": "public/icons/icon-192.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lutfialdrii/zen-clock.git"
  },
  "keywords": [
    "zen",
    "clock",
    "flip clock",
    "pomodoro",
    "timer",
    "productivity",
    "prayer times",
    "muslim",
    "jadwal sholat",
    "adhan",
    "azan",
    "reminder"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Productivity",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "extension-clock.openClock",
        "title": "Open Flip Clock Panel",
        "category": "Zen Clock"
      },
      {
        "command": "extension-clock.changeLocation",
        "title": "Change City / Location (Pilih Kota)",
        "category": "Zen Clock"
      },
      {
        "command": "extension-clock.adjustPrayerTimes",
        "title": "Adjust Prayer Times (Sesuaikan Menit Waktu Sholat)",
        "category": "Zen Clock"
      },
      {
        "command": "extension-clock.focusPanel",
        "title": "Focus Bottom Panel",
        "category": "Zen Clock"
      },
      {
        "command": "extension-clock.previewReminder",
        "title": "Preview Prayer Reminder Page",
        "category": "Zen Clock"
      },
      {
        "command": "extension-clock.togglePomodoro",
        "title": "Start / Pause Pomodoro Timer",
        "category": "Zen Clock"
      },
      {
        "command": "extension-clock.resetPomodoro",
        "title": "Reset Pomodoro Timer",
        "category": "Zen Clock"
      },
      {
        "command": "extension-clock.changeAccentColor",
        "title": "Change Accent Color Theme (Ubah Warna Tema)",
        "category": "Zen Clock"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "zen-clock-sidebar-container",
          "title": "Zen Clock",
          "icon": "$(watch)"
        }
      ],
      "panel": [
        {
          "id": "zen-clock-panel-container",
          "title": "Zen Clock",
          "icon": "$(watch)"
        }
      ]
    },
    "views": {
      "zen-clock-sidebar-container": [
        {
          "type": "webview",
          "id": "zen-clock-sidebar",
          "name": "Zen Clock"
        }
      ],
      "zen-clock-panel-container": [
        {
          "type": "webview",
          "id": "zen-clock-panel-view",
          "name": "Zen Clock"
        }
      ]
    },
    "configuration": {
      "title": "Zen Clock",
      "properties": {
        "zenClock.autoOpenPrayerReminder": {
          "type": "boolean",
          "default": true,
          "description": "Otomatis buka tab halaman pengingat waktu sholat saat waktu sholat tiba (Automatically open prayer reminder tab when prayer time arrives)."
        },
        "zenClock.accentColor": {
          "type": "string",
          "default": "#fbbf24",
          "description": "Warna aksen tema untuk Zen Clock, Pomodoro, dan Pengingat Sholat (Theme accent color for Zen Clock, Pomodoro, and Prayer Reminder). Format: preset nama atau kode hex (e.g. #fbbf24, #10b981)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build:extension",
    "compile": "tsc -p ./ --noEmit && esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --sourcemap && vite build",
    "watch": "tsc -watch -p ./ --noEmit",
    "build": "npm run compile",
    "build:web": "vite build",
    "build:extension": "npm run compile",
    "preview": "vite preview",
    "dev": "vite",
    "package:vsix": "npx @vscode/vsce package",
    "release:patch": "npm version patch -m 'chore(release): v%s'",
    "release:minor": "npm version minor -m 'chore(release): v%s'",
    "release:major": "npm version major -m 'chore(release): v%s'"
  },
  "dependencies": {
    "adhan": "^4.4.3",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.80.0",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.0.0",
    "vite": "^8.0.1"
  }
}
